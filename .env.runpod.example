# Copy to .env.runpod and fill in your credentials. Run from the repository root.
AUDYSSEY_PLANNER=real
AUDYSSEY_PLANNER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AUDYSSEY_PLANNER_MODEL=gemini-2.5-flash
AUDYSSEY_PLANNER_API_KEY=
AUDYSSEY_SEPARATOR=real
AUDYSSEY_FILTER=real
AUDYSSEY_GROUNDER=real
AUDYSSEY_GENERATOR=real
AUDYSSEY_VISUAL_PROMPT=false
AUDYSSEY_WORK_DIR=/workspace/audyssey-results/run01
AUDYSSEY_MAX_DURATION_S=30
CUDA_VISIBLE_DEVICES=0
HF_HOME=/workspace/huggingface
# Leave offline disabled for first use so accessible weights can be downloaded.
HF_HUB_OFFLINE=0
# Use an HF read token with access to the required gated/private models.
HF_TOKEN=
# Relative to repository root; append other library directories here if required.
LD_LIBRARY_PATH=gpu/.venv/lib/python3.12/site-packages/nvidia/npp/lib
